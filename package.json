{
	"name": "http-scanner",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "npm run dev:web",
		"dev:web": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
		"dev:worker": "wrangler dev --config wrangler.jsonc --local --port 8787",
		"build": "npm run check && ASTRO_TELEMETRY_DISABLED=1 astro build",
		"check": "ASTRO_TELEMETRY_DISABLED=1 astro check --tsconfig tsconfig.astro.json && tsc -b",
		"test": "vitest run --config vitest.config.ts",
		"lint": "eslint .",
		"preview": "npm run build && ASTRO_TELEMETRY_DISABLED=1 astro preview",
		"deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
		"deploy:dry": "npm run build && wrangler deploy --config wrangler.jsonc --dry-run",
		"cf-typegen": "wrangler types --config wrangler.jsonc --include-runtime false"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.1",
		"@astrojs/sitemap": "^3.7.3",
		"@hookform/resolvers": "^5.0.1",
		"@radix-ui/react-alert-dialog": "^1.1.13",
		"@radix-ui/react-label": "^2.1.4",
		"@radix-ui/react-slot": "^1.2.2",
		"@radix-ui/react-tabs": "^1.1.11",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.1.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"hono": "^4.12.31",
		"lucide-react": "^0.503.0",
		"posthog-js": "^1.391.6",
		"posthog-node": "^5.37.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-hook-form": "^7.56.1",
		"tailwind-merge": "^3.2.0",
		"tailwindcss": "^4.3.3",
		"workers-og": "^0.0.25",
		"zod": "^3.24.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@cloudflare/workers-types": "^5.20260719.1",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.14.1",
		"@types/react": "^19.0.10",
		"@types/react-dom": "^19.0.4",
		"@typescript-eslint/parser": "^8.64.0",
		"eslint": "^10.7.0",
		"eslint-plugin-astro": "^3.0.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.7.0",
		"tw-animate-css": "^1.2.8",
		"typescript": "~5.7.2",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"wrangler": "^4.112.0"
	}
}
