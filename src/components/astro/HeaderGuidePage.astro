---
import type { CollectionEntry } from 'astro:content';
import type { HeaderCatalogEntry } from '@/lib/headerCatalog';

interface Props {
  guide: CollectionEntry<'headers'>;
  catalogEntry: HeaderCatalogEntry;
  relatedEntries: HeaderCatalogEntry[];
}

const { guide, catalogEntry, relatedEntries } = Astro.props;
const isSecurityOrPrivacy = catalogEntry.category === 'Security and privacy';
---

<article>
  <header class="border-b border-border/60 bg-gradient-to-b from-muted/50 to-background">
    <div class="site-container px-4 py-14 sm:py-16">
      <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
        <a
          class="underline-offset-4 hover:underline"
          href="/headers/"
          data-analytics-event="checker to guide clicked"
          data-analytics-header-name={catalogEntry.displayName}
        >HTTP Header Reference</a>
        <span aria-hidden="true"> / </span>
        <span>{catalogEntry.displayName}</span>
      </nav>
      <p class="mt-8 text-sm font-semibold uppercase tracking-wider text-muted-foreground">
        {catalogEntry.category}
      </p>
      <h1 class="mt-3 break-words text-4xl font-bold tracking-tight sm:text-5xl">
        {catalogEntry.displayName} HTTP Header
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-muted-foreground">
        {catalogEntry.summary}
      </p>
    </div>
  </header>

  <div class="site-container grid gap-10 px-4 py-14 lg:grid-cols-[minmax(0,1fr)_18rem] sm:py-16">
    <div class="min-w-0 space-y-12">
      <section aria-labelledby="applicability">
        <h2 id="applicability" class="text-2xl font-semibold tracking-tight">Applicability</h2>
        <p class="mt-4 leading-7 text-muted-foreground">
          This field applies to {guide.data.applicability === 'response'
            ? 'HTTP responses.'
            : 'both HTTP requests and responses.'}
        </p>
      </section>

      <section aria-labelledby="syntax">
        <h2 id="syntax" class="text-2xl font-semibold tracking-tight">Syntax</h2>
        <pre class="mt-4 max-w-full overflow-x-auto rounded-lg border border-border bg-muted/30 p-5 text-sm"><code>{guide.data.syntax}</code></pre>
      </section>

      <section aria-labelledby="examples">
        <h2 id="examples" class="text-2xl font-semibold tracking-tight">Examples</h2>
        <div class="mt-4 space-y-3">
          {guide.data.examples.map((example) => (
            <pre class="max-w-full overflow-x-auto rounded-lg border border-border bg-muted/30 p-5 text-sm"><code>{example}</code></pre>
          ))}
        </div>
      </section>

      <section aria-labelledby="use-cases">
        <h2 id="use-cases" class="text-2xl font-semibold tracking-tight">Common use cases</h2>
        <ul class="mt-4 list-disc space-y-2 pl-6 leading-7 text-muted-foreground">
          {guide.data.useCases.map((useCase) => <li>{useCase}</li>)}
        </ul>
      </section>

      <section aria-labelledby="mistakes">
        <h2 id="mistakes" class="text-2xl font-semibold tracking-tight">Common mistakes</h2>
        <ul class="mt-4 list-disc space-y-2 pl-6 leading-7 text-muted-foreground">
          {guide.data.commonMistakes.map((mistake) => <li>{mistake}</li>)}
        </ul>
      </section>

      <section aria-labelledby="security-considerations">
        <h2 id="security-considerations" class="text-2xl font-semibold tracking-tight">
          Security considerations
        </h2>
        <p class="mt-4 leading-7 text-muted-foreground">{guide.data.securityConsiderations}</p>
        {isSecurityOrPrivacy && (
          <p class="mt-4 leading-7 text-muted-foreground">
            Use the <a
              class="font-semibold underline underline-offset-4"
              href="/"
              data-analytics-event="guide to checker clicked"
              data-analytics-header-name={catalogEntry.displayName}
            >Security Headers Checker</a>
            {' '}to evaluate supported browser-facing protections on a public website.
          </p>
        )}
      </section>

      <section aria-labelledby="details">
        <h2 id="details" class="sr-only">Detailed guidance</h2>
        <div class="guide-markdown">
          <slot />
        </div>
      </section>

      <section aria-labelledby="sources">
        <h2 id="sources" class="text-2xl font-semibold tracking-tight">Sources</h2>
        <ul class="mt-4 list-disc space-y-2 pl-6 leading-7 text-muted-foreground">
          {guide.data.references.map((reference) => (
            <li><a class="underline underline-offset-4" href={reference.url}>{reference.label}</a></li>
          ))}
        </ul>
      </section>
    </div>

    <aside class="space-y-6 lg:sticky lg:top-6 lg:self-start">
      <div class="rounded-lg border border-border bg-card p-5">
        <h2 class="font-semibold">Related headers</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {relatedEntries.map((entry) => (
            <li><a
              class="underline underline-offset-4"
              href={`/headers/${entry.slug}/`}
              data-analytics-event="checker to guide clicked"
              data-analytics-header-name={entry.displayName}
            >{entry.displayName}</a></li>
          ))}
        </ul>
      </div>
      <div class="rounded-lg border border-border bg-muted/30 p-5">
        <h2 class="font-semibold">Inspect a live response</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          Check the headers returned by any public URL, with no account required.
        </p>
        <a
          class="mt-4 inline-block font-semibold underline underline-offset-4"
          href="/http-headers-checker/"
          data-analytics-event="guide to checker clicked"
          data-analytics-header-name={catalogEntry.displayName}
        >
          Open HTTP Headers Checker
        </a>
      </div>
    </aside>
  </div>
</article>

<style>
  .guide-markdown :global(h2) {
    margin-top: 3rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .guide-markdown :global(p) {
    margin-top: 1rem;
    line-height: 1.75rem;
    color: var(--muted-foreground);
  }

  .guide-markdown :global(ol),
  .guide-markdown :global(ul) {
    margin-top: 1rem;
    padding-left: 1.5rem;
    color: var(--muted-foreground);
    line-height: 1.75rem;
  }

  .guide-markdown :global(ol) {
    list-style-type: decimal;
  }

  .guide-markdown :global(ul) {
    list-style-type: disc;
  }

  .guide-markdown :global(li + li) {
    margin-top: 0.5rem;
  }

  .guide-markdown :global(table) {
    width: 100%;
    margin-top: 1rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-spacing: 0;
    border-radius: 0.625rem;
    background-color: var(--card);
    table-layout: fixed;
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .guide-markdown :global(thead) {
    background-color: color-mix(
      in oklab,
      var(--muted) 50%,
      transparent
    );
  }

  .guide-markdown :global(th),
  .guide-markdown :global(td) {
    padding: 0.75rem 1rem;
    overflow-wrap: anywhere;
    text-align: left;
    vertical-align: top;
  }

  .guide-markdown :global(th) {
    border-bottom: 1px solid var(--border);
    color: var(--foreground);
    font-weight: 600;
  }

  .guide-markdown :global(td) {
    color: var(--muted-foreground);
  }

  .guide-markdown :global(tbody tr:not(:last-child) td) {
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .guide-markdown :global(table) {
      display: block;
      overflow-x: auto;
      table-layout: auto;
    }

    .guide-markdown :global(th),
    .guide-markdown :global(td) {
      min-width: 10rem;
    }
  }

  .guide-markdown :global(code) {
    overflow-wrap: anywhere;
  }

  .guide-markdown :global(pre.astro-code) {
    margin-top: 1rem;
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    background-color: color-mix(
      in oklab,
      var(--muted) 30%,
      transparent
    ) !important;
    padding: 1.25rem;
    color: var(--foreground) !important;
    font-size: 0.875rem;
    line-height: 1.25rem;
    white-space: pre;
  }

  .guide-markdown :global(pre.astro-code span) {
    color: inherit !important;
  }

  .guide-markdown :global(pre code) {
    overflow-wrap: normal;
    word-break: normal;
  }
</style>
