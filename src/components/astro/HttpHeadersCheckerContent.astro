<section aria-labelledby="header-example" class="border-y border-border/60 bg-muted/30">
  <div class="site-container mx-auto px-4 py-14 sm:py-16">
    <div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-2 lg:items-center">
