---
import scannerLogo from '@/assets/scanner-logo.png';
import { RecentScansIsland } from '@/components/islands/RecentScansIsland';
import { ScannerIsland } from '@/components/islands/ScannerIsland';
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'HTTP Security Header Scanner — Free Website Security Check';
const description = 'Scan a website for missing, weak and leaking HTTP security headers. Get a clear security score and an actionable report in seconds.';
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <section class="border-b border-border/60 bg-gradient-to-b from-muted/50 to-background">
    <div class="container mx-auto px-4 py-16 text-center sm:py-20">
      <div class="mb-6 inline-flex items-center justify-center rounded-full bg-primary/10 p-3">
        <img src={scannerLogo.src} alt="" width="32" height="32" class="h-8 w-8" />
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight sm:text-5xl">
        Scan your website for HTTP security headers
      </h1>
      <p class="mx-auto mb-10 mt-5 max-w-2xl text-lg text-muted-foreground">
        Find missing protections, information leaks and configuration weaknesses. HTTP Scanner returns a practical report without requiring an account.
      </p>

      <ScannerIsland client:load />
    </div>
  </section>

  <section aria-labelledby="what-we-check" class="container mx-auto px-4 py-14">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto mb-9 max-w-2xl text-center">
        <h2 id="what-we-check" class="text-3xl font-semibold tracking-tight">What the scan checks</h2>
        <p class="mt-3 text-muted-foreground">
          The scanner evaluates response headers that help browsers enforce safer behavior and reduce accidental exposure.
        </p>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        <article class="rounded-lg border border-border bg-card p-6">
          <h3 class="font-semibold">Missing protections</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">
            Identify absent headers such as Content-Security-Policy, Strict-Transport-Security and protections against content-type confusion.
          </p>
        </article>
        <article class="rounded-lg border border-border bg-card p-6">
          <h3 class="font-semibold">Risky configuration</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">
            Review detected values and see where a header is present but does not provide the expected level of protection.
          </p>
        </article>
        <article class="rounded-lg border border-border bg-card p-6">
          <h3 class="font-semibold">Information leakage</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">
            Surface response headers that reveal unnecessary server or framework details to visitors and automated scanners.
          </p>
        </article>
      </div>
    </div>
  </section>

  <div class="container mx-auto px-4">
    <RecentScansIsland client:visible />
  </div>
</BaseLayout>
